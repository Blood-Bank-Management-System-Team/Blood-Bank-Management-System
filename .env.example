# --- Django core ---
# Required (a real, random value of 32+ characters) whenever DJANGO_DEBUG is False.
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# True for local development; must be False in production (the server compose file forces it).
DJANGO_DEBUG=True
# Comma-separated host names this site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated trusted origins for CSRF, including the scheme (needed for HTTPS in production).
# Example: https://bbms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS hardening (only applied when DJANGO_DEBUG=False; all default to the values shown) ---
# Redirect plain HTTP to HTTPS (/api/health/ is exempt).
DJANGO_SECURE_SSL_REDIRECT=True
# Only send the session and CSRF cookies over HTTPS.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Trust X-Forwarded-Proto from the reverse proxy to detect HTTPS. Turn off if there is no proxy.
DJANGO_SECURE_PROXY_SSL_HEADER=True
# HSTS: seconds browsers must keep using HTTPS (0 disables). Start small when first enabling.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# --- Database ---
# Single connection string (e.g. Neon: use the pooled one). When set, the DB_* values below are ignored.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Seconds to keep a database connection open between requests (DATABASE_URL and DB_HOST only).
# CONN_MAX_AGE=60
# Postgres SSL mode when using the DB_* values, e.g. require.
# DB_SSLMODE=
DB_NAME=bbms
DB_USER=bbms
DB_PASSWORD=bbms_password
# Leave DB_HOST empty to use SQLite locally; docker-compose sets it to "db".
DB_HOST=
DB_PORT=5432

# --- Production server only (docker-compose.prod.yml) ---
# Where the web container listens on the host. Default is localhost only (behind a reverse proxy).
# WEB_PORT_BIND=127.0.0.1:8000

# --- Container runtime ---
# Gunicorn options, e.g. "--workers 3 --access-logfile -" (set in the image; override if needed).
# GUNICORN_CMD_ARGS=--workers 3
# Set to 0 to skip "manage.py migrate" at container start.
# RUN_MIGRATIONS=1

# --- Email (password-reset OTPs and notifications) ---
# With none of these set, emails are printed in the server terminal (fine for local testing).
# Option A: Brevo HTTPS API (free tier). Required on Render's free plan, which blocks SMTP.
# BREVO_API_KEY=
# Option B: SMTP, e.g. Gmail with an app password (https://myaccount.google.com/apppasswords).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=True
# Sender address. With Brevo it must be a sender verified in your Brevo account.
# DEFAULT_FROM_EMAIL=BBMS <you@gmail.com>

# --- First admin (created at container start if the username does not exist yet) ---
# The password of an existing user is never changed. Leave unset to skip.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Business rules ---
BBMS_MIN_DONATION_INTERVAL_DAYS=90

# --- Automated PostgreSQL backups ---
# Backup interval in seconds (86400 = 24 hours).
BACKUP_INTERVAL_SECONDS=86400
# Delete backup files older than this number of days after a successful backup.
BACKUP_RETENTION_DAYS=7
